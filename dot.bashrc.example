# Compute a tmux-safe session name from args (default: hostname)
_tm_name() {
    local name
    if (( $# )); then
        name=$(IFS=-; echo "$*")
    else
        name=$(hostname -s)
    fi
    name=${name,,}      # lowercase
    name=${name//./-}   # tmux disallows dots
    echo "${name:0:30}" # truncate
}

# tm: simple tmux session manager
#
# Usage examples:
#
#   tm            -> default session (hostname)
#   tm ls         -> list sessions
#   tm my project -> session 'my-project'
tm() {
    if [[ "$1" == "ls" ]]; then
        tmux list-sessions
        return
    fi

    local name
    name=$(_tm_name "$@")

    tmux has-session -t "=$name" 2>/dev/null || tmux new-session -d -s "$name"

    if [[ -n "$TMUX" ]]; then
        tmux switch-client -t "=$name"
    else
        tmux attach-session -t "=$name"
    fi
}

# Auto-attach on SSH login
#
# `exec` replaces the login shell with tmux, so when tmux ends (last shell
# exits, or you detach), the SSH connection closes too.
#
# To skip auto-attach (get a plain shell):
#
#   ssh -t host 'NO_TM=1 bash -i'    # sets the guard variable
#   ssh -t host bash --norc          # doesn't read ~/.bashrc at all
#   ssh host command                 # non-interactive; this block never runs
#
# Or, on the machine itself: `touch ~/.no_tmux` to disable it (rm to re-enable).
if [[ $- == *i* && -z "$TMUX" && -z "$NO_TMUX" && -n "$SSH_CONNECTION" 
      && ! -e ~/.no_tmux ]] && command -v tmux >/dev/null; then
    _name=$(_tm_name)
    tmux has-session -t "=$_name" 2>/dev/null || tmux new-session -d -s "$_name"
    exec tmux attach-session -t "=$_name"
fi
